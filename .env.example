# OpenAI API key (required for LLM + STT)
OPENAI_API_KEY=sk-...

# ElevenLabs API key (optional, enables voice output)
ELEVENLABS_API_KEY=...

# ElevenLabs voice ID — defaults to Rachel (multilingual, professional)
# Find more voices at: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Default language: nl or en
DEFAULT_LANGUAGE=nl

# OpenAI model to use
OPENAI_MODEL=gpt-4o
